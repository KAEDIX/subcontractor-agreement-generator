AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
AZURE_TENANT_ID=
REDIRECT_URI=

# DocuSeal e-signature API token (X-Auth-Token). Production token — each
# signed document costs $0.20. Never commit the real value.
DOCUSEAL_API_TOKEN=

# CSI trade list (kdx_reference Postgres). Same value the lien waiver
# generator uses; on kdx-dev-1 the database is local to the box.
KDX_REFERENCE_URL=postgresql://user:password@localhost:5432/kdx_reference
